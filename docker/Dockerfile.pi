# DEPRECATED — use channels/chi-edge/Dockerfile instead
# This file is kept for reference during the transition to the channels/ structure.
# Build via: make build-chi-edge
#
# Dockerfile.pi — Raspberry Pi 5 edge collector for SO-ARM101
#
# Hardware:
#   - SO-ARM101 leader arm  (Feetech STS3215, /dev/ttyACM0)
#   - SO-ARM101 follower arm (Feetech STS3215, /dev/ttyACM1)
#   - Logitech C920e USB webcam (/dev/video0)
#
# CHI@Edge container — device profiles required (no --privileged):
#   device_profiles=["ttyacm0", "ttyacm1", "video0", "video1", "video2", "video3"]
#
# Pull pre-built arm64 image (recommended — cross-built on x86 with buildx):
#   docker pull rianders/lerobot-soarm101:latest
#
# Build locally if you need to modify the image:
#   # On x86 with buildx (cross-compile for arm64):
#   docker buildx build --platform linux/arm64 --load \
#     -t rianders/lerobot-soarm101:latest -f docker/Dockerfile.pi .
#   # On the Pi itself (native arm64):
#   docker build -t rianders/lerobot-soarm101:latest -f docker/Dockerfile.pi .
#
# Run locally (full device access for testing):
#   docker run -it --privileged -v /dev:/dev \
#     -v $(pwd)/data:/app/data \
#     -e HF_TOKEN=hf_xxx -e HF_USER=rianders \
#     rianders/lerobot-soarm101:latest
#
# Run on CHI@Edge (via python-chi Container API — no privileged):
#   device_profiles=["ttyacm0", "ttyacm1", "video0", "video1", "video2", "video3"]

FROM arm64v8/python:3.12-slim-bookworm

# System deps: USB serial, V4L2 cameras, video encoding, SSH access
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ffmpeg \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libusb-1.0-0 \
    usbutils \
    v4l-utils \
    curl \
    # openssh-server — container is reachable at the CHI@Edge floating IP via SSH
    openssh-server \
    # build-essential + linux-libc-dev needed to build evdev (pynput dep of lerobot)
    build-essential \
    linux-libc-dev \
    # spd-say needed by lerobot play_sounds (even when disabled, avoids FileNotFoundError)
    speech-dispatcher \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN curl -Ls https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

WORKDIR /app

# CPU-only PyTorch (Pi 5 has no GPU)
RUN uv pip install --system --no-cache \
    torch torchvision torchaudio \
    --index-url https://download.pytorch.org/whl/cpu

# LeRobot v0.5.0 with Feetech servo support (SO-ARM101 uses STS3215)
RUN git clone https://github.com/huggingface/lerobot.git /app/lerobot \
    && cd /app/lerobot \
    && git checkout v0.5.0 \
    && uv pip install --system --no-cache -e '.[feetech]'

# Install coachable package (fleet management + coaching CLI)
# Includes gradio, opencv-headless, pyyaml
COPY pyproject.toml README.md /app/coachable-robots/
COPY src/ /app/coachable-robots/src/
RUN uv pip install --system --no-cache -e /app/coachable-robots

# HuggingFace CLI — use pip (not uv) to ensure the huggingface-cli entry point
# is created in /usr/local/bin and is on PATH.
RUN pip install --no-cache-dir "huggingface-hub[hf_xet,cli]"

# Scripts and entrypoint
COPY docker/scripts/ /app/scripts/
RUN chmod +x /app/scripts/*.sh /app/scripts/*.sh 2>/dev/null || true

ENTRYPOINT ["/app/scripts/entrypoint.sh"]

# Fleet config — override at runtime with -v /path/to/fleet.yaml:/app/config/fleet.yaml
COPY config/fleet.example.yaml /app/config/fleet.yaml
RUN mkdir -p /app/calibration /app/data /app/checkpoints

# HF_TOKEN and HF_USER must be passed at runtime: -e HF_TOKEN=hf_xxx
ENV HF_LEROBOT_HOME="/app"
ENV FLEET_CONFIG="/app/config/fleet.yaml"
ENV LEADER_PORT="/dev/ttyACM0"
ENV FOLLOWER_PORT="/dev/ttyACM1"
ENV CAMERA_INDEX="0"

CMD ["/bin/bash"]
