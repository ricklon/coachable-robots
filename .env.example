# .env.example — Coachable Robots shared project state
#
# Copy to .env and fill in values from your ansible vault:
#   cp .env.example .env
#   ansible-vault view ansible/group_vars/all/vault.yml  # to read secrets
#
# .env is gitignored — never commit real values.
# Notebooks load this at startup via python-dotenv.
# justfile exports these into the shell for CLI tools.

# ── HuggingFace ──────────────────────────────────────────────────────────────
HF_USER=your_hf_username
HF_TOKEN=hf_REPLACE_ME

# ── Chameleon Cloud ───────────────────────────────────────────────────────────
# From a CHI@TACC application credential for MI100 leases:
# Chameleon dashboard → Identity → Application Credentials
CHI_CREDENTIAL_ID=REPLACE_ME
CHI_CREDENTIAL_SECRET=REPLACE_ME
OS_AUTH_TYPE=v3applicationcredential
OS_APPLICATION_CREDENTIAL_ID=REPLACE_ME
OS_APPLICATION_CREDENTIAL_SECRET=REPLACE_ME

# Chameleon project and site
OS_PROJECT_NAME=CHI-XXXXXX
OS_PROJECT_DOMAIN_NAME=chameleon
OS_AUTH_URL=https://chi.tacc.chameleoncloud.org:5000/v3
OS_REGION_NAME=CHI@TACC

# ── Lease / Server ────────────────────────────────────────────────────────────
LEASE_NAME=coachable-robots-mi100
LEASE_DURATION_HOURS=6
SERVER_NAME=coachable-training-node
KEY_PAIR_NAME=your_keypair_name

# ── CHI@Edge arm-01 Lease / Container ────────────────────────────────────────
EDGE_RC_FILE=ansible/app-cred-chi-edge-openrc.sh
EDGE_LEASE_NAME=arm-01-lease
EDGE_UNIQUE_LEASE_NAMES=yes
EDGE_LEASE_DAYS=7
EDGE_DEVICE_NAME=soarm101-1
EDGE_CONTAINER_NAME=arm-01-container
EDGE_IMAGE_REF=rianders/lerobot-soarm101:arm
EDGE_DEVICE_PROFILES=ttyacm0,ttyacm1,video0,video1,video2,video3
# Optional: pin to an existing lease by ID (overrides name search — useful after a portal-created lease)
EDGE_LEASE_ID=

# Tailscale — set TS_AUTHKEY to join the container to your tailnet on startup
# Generate a reusable+ephemeral key at https://login.tailscale.com/admin/settings/keys
# One key works for all nodes (arm-*, train-*, infer-*, control).
TS_AUTHKEY=
TS_HOSTNAME=arm-01

# Populated after 01_reserve_node runs — paste floating IP here
CONTROL_FLOATING_IP=REPLACE_ME_AFTER_PROVISION

# ── Pi Edge Node ──────────────────────────────────────────────────────────────
# When using Tailscale, set PI_HOST to the arm's Tailscale hostname and PI_PORT=22.
# Without Tailscale, use the direct IP and balena SSH port 22222.
PI_HOST=arm-01
PI_PORT=22

# ── Training ──────────────────────────────────────────────────────────────────
# HuggingFace dataset and model repo IDs
# Pattern: {HF_USER}/{prefix}-{task}  — fill in your HF username explicitly
# python-dotenv does not expand ${VAR} references
DATASET_REPO_ID=your_hf_username/soarm101-pick-block
MODEL_REPO_ID=your_hf_username/act-pick-block

# Training policy (act | diffusion | pi0)
POLICY=act

# ── Task Definitions ──────────────────────────────────────────────────────────
# Touch task (05_touch_objects.ipynb)
TASK_TOUCH_SLUG=touch-block
TASK_TOUCH_DESC="Touch the red block on the table"

# Pick and place task (06_pick_place.ipynb)
TASK_PICK_SLUG=pick-place-block
TASK_PICK_DESC="Pick up the red block and place it in the bowl"

# ── Talkbot ───────────────────────────────────────────────────────────────────
# LLM backend: local | openrouter
TALKBOT_LLM_BACKEND=local
# If using OpenRouter:
OPENROUTER_API_KEY=REPLACE_ME_IF_USING_OPENROUTER  # set vault_openrouter_api_key in vault.yml → just vault-to-env
# Agent personality prompt (can point to a file in prompts/)
TALKBOT_AGENT_PROMPT="You are a coaching assistant for a robot arm. Help the student record quality demonstration episodes."
